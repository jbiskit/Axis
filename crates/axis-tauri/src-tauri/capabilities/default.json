{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Axis desktop default permissions",
  "windows": ["main", "popout-*"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize",
    "opener:default",
    "shell:allow-open"
  ]
}
