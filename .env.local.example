# Optional desktop device-code overrides. Axis needs no configuration by default.
# Device code uses Microsoft Graph Command Line Tools unless you set a public client.

# AXIS_DEVICE_CODE_CLIENT_ID=
# AXIS_AZURE_TENANT_ID=

# Optional: ASD Blueprint Intune config policy source (dynamic baselines)
# Defaults to ASD-Blueprint/ASD-Blueprint-for-Secure-Cloud .../intune-config-policies
# ASD_BLUEPRINT_OWNER=ASD-Blueprint
# ASD_BLUEPRINT_REPO=ASD-Blueprint-for-Secure-Cloud
# ASD_BLUEPRINT_PATH=static/content/files/intune-config-policies
# ASD_BLUEPRINT_REF=main
